# --- Python bytecode / caches ---------------------------------------------
__pycache__/
*.py[cod]
*.pyc
*.pyo

# --- Build / packaging artifacts ------------------------------------------
build/
dist/
*.egg-info/
.eggs/
*.egg

# --- Test / tooling caches ------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/

# --- nodepilot runtime files ----------------------------------------------
# Generated by the orchestrator at run time (paths are configurable; these are
# the defaults from config.Config). Keep them out of version control.
nodepilot_state.json    # state_path: JSON snapshot for crash-safe resume
nodepilot.log           # log_path: structured run log
*.pause                 # pause_file sentinel (default .nodepilot.pause)
*.tmp                   # atomic-write temp files (e.g. nodepilot_state.json.tmp)

# --- Editor / OS noise ----------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
